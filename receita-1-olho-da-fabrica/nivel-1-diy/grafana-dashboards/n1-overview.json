      },
      "id": 1,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "TimescaleDB"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time_bucket('1 minute', ts) AS time, machine AS metric, AVG(value) AS value FROM telemetry WHERE metric = 'current_a' AND ts > NOW() - INTERVAL '8 hours' GROUP BY 1, machine ORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Current draw (A) per machine — last 8 h",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "postgres",
        "uid": "TimescaleDB"
      },
      "description": "Per-machine state derived from the most recent 5 minutes of telemetry.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "color-background"
            },
            "inspect": false
          },
          "mappings": [
            {
              "options": {
                "parado": {
                  "color": "red",
                  "index": 0
                }
              },
              "type": "value"
            },
            {
              "options": {
                "em vazio": {
                  "color": "yellow",
                  "index": 1
                }
              },
              "type": "value"
            },
            {
              "options": {
                "a produzir": {
                  "color": "green",
                  "index": 2
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 11,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "id": 2,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "TimescaleDB"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT machine, CASE WHEN AVG(value) < 0.5 THEN 'parado' WHEN AVG(value) < 2.0 THEN 'em vazio' ELSE 'a produzir' END AS estado, ROUND(AVG(value)::numeric, 2) AS corrente_media_a FROM telemetry WHERE metric = 'current_a' AND ts > (SELECT max(ts) FROM telemetry WHERE metric='current_a') - INTERVAL '5 minutes' GROUP BY machine ORDER BY machine",
          "refId": "A"
        }
      ],
      "title": "Current state per machine (last 5 minutes)",
      "type": "table"
    },
    {
      "datasource": {
        "type": "postgres",
        "uid": "TimescaleDB"
      },
      "description": "Fraction of samples with the machine stopped (current < 0.5 A), split by shift. Line 3's afternoon bar is the field-case signal (thermal trips).",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 1,
            "axisLabel": "% stopped"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 11,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "id": 3,
      "options": {
        "orientation": "horizontal",
        "stacking": "none",
        "showValue": "auto",
        "groupWidth": 0.7,
        "barWidth": 0.9,
        "xTickLabelRotation": 0,
        "fullHighlight": false,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT machine, round(100*AVG((value < 0.5)::int) FILTER (WHERE EXTRACT(hour FROM ts) BETWEEN 6 AND 13)::numeric,1) AS morning, round(100*AVG((value < 0.5)::int) FILTER (WHERE EXTRACT(hour FROM ts) BETWEEN 14 AND 21)::numeric,1) AS afternoon, round(100*AVG((value < 0.5)::int) FILTER (WHERE EXTRACT(hour FROM ts) NOT BETWEEN 6 AND 21)::numeric,1) AS night FROM telemetry WHERE metric = 'current_a' GROUP BY machine ORDER BY machine"
        }
      ],
      "title": "Stopped fraction by machine and shift (24 h)",
      "type": "barchart"
    }
  ],
